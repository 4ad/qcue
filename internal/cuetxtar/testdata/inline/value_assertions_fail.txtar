Incorrect public API expectations must fail, including an incomplete value
mistaken for a contradiction or an abstract call mistaken for a result.

-- in/test.cue --
wrong: 3 @test(json, 4)
unknown: int @test(validate, concrete) @test(validate, conflict)
conflict: 1 & "x" @test(validate, concrete, incomplete)
complete: 3 @test(validate, concrete, incomplete)
pending: func(int) -> int @test(validate, functions)
abstract: func(int) -> int
result: abstract(3) @test(json, 3)
broad: number
narrow: int
@test(subsume, narrow, broad)
@test(subsume, broad, narrow, fail)
@test(json, 4, at="wrong")
