# Guards against a performance regression in deeply nested native function
# calls. The body of twice consumes its parameter twice (sum(n, n)), so a
# naive evaluator re-expands each argument once per use and the cost of an
# n-deep nesting grows exponentially in n. Memoizing finalized, error-free
# call results collapses this to linear growth. A regression toward the old
# behavior balloons the unification count in the stats section below, well
# beyond what the shallow (depth <= 4) cases in functions/native.txtar can
# detect.
-- in.cue --
@experiment(functions,quantified=false)

sum:   func(a: int, b: int) -> int: a + b
twice: func(n: int) -> int: sum(n, n)

// twice^k(2) == 2^(k+1). The chain is a stack of distinct call sites, which
// nest freely without a structural cycle; only result memoization keeps its
// evaluation cost linear rather than exponential in the depth.
deep: twice(twice(twice(twice(twice(twice(twice(twice(2))))))))
-- out/compile --
--- in.cue
{
  sum: func(a: int, b: int) -> int: (〈0;a〉 + 〈0;b〉)
  twice: func(n: int) -> int: 〈1;sum〉(〈0;n〉, 〈0;n〉)
  deep: 〈0;twice〉(〈0;twice〉(〈0;twice〉(〈0;twice〉(〈0;twice〉(〈0;twice〉(〈0;twice〉(〈0;twice〉(2))))))))
}
