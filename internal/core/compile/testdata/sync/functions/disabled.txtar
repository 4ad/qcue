-- in.cue --
@experiment(functions=false,quantified=false)
func: len
out: func("foo")

// Interpolations in the arguments must not derail the lookahead that
// distinguishes disabled function syntax from a regular call of a field
// named "func".
s: "foo"
out2: func("\(s)")
out3: func("\(s): 1")
-- out/compile --
--- in.cue
{
  func: len
  out: 〈0;func〉("foo")
  s: "foo"
  out2: 〈0;func〉("\(〈0;s〉)")
  out3: 〈0;func〉("\(〈0;s〉): 1")
}
