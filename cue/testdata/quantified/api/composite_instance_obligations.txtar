-- case01.cue --
module: forall (A) {id: func(x: A) -> A: x}
out:    module[int].id("x")
-- case02.cue --
module: forall (A: number) {id: func(x: A) -> A: x}
out:    module[string].id("x")
-- case03.cue --
module: forall (A) {value: A}
out:    module[int].value
-- case04.cue --
module: forall (A in Type(0)) {id: func(x: A) -> A: x}
out:    module[forall (B in Type(0)) func(B) -> B]
-- case05.cue --
@experiment(quantified)
module:
	forall (A) {value: int, id: func(x: A) -> A: x}
out: module[string].value
