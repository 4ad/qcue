// Residual templates retain substitutions and lexical dependencies.

#skip
#inlinetest:exclude Run by cue/quantified_test.go.

-- existential.cue --
Q(A) = forall (B) {value: A}
r: Q(int)
-- existential-want.cue --
forall (B) {value: (int)}
-- universal.cue --
Q(A) = forall (B) ((func(B) -> B) | (func() -> A))
r: Q(int)
-- universal-want.cue --
forall (B) ((func(B) -> B) | (func() -> (int)))
-- capture.cue --
limit:  5
#Bound: int & >=limit
Q(A) = forall (B) {value: A, bound: #Bound, captured: limit}
r: Q(string)
-- capture-want.cue --
forall (B) {value: (string), bound: (int & >=5), captured: (5)}
-- shadow.cue --
Q(A) = forall (B) {value: A, nested: forall (A) {value: A}}
r: Q(int)
-- shadow-want.cue --
forall (B) {value: (int), nested: forall (A) {value: A}}
-- bound.cue --
Q(A) = forall (B: A) {value: B}
r: Q(int)
-- bound-want.cue --
forall (B: (int)) {value: B}
