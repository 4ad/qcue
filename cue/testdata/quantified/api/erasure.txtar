-- result.cue --
f: forall (A: int) func() -> int: A
-- argument.cue --
id: func(x: int) -> int: x
f:
	forall (A: int) func() -> int: id(A)
-- default.cue --
f: forall (A: int) func(x: int = A) -> int: x
-- alias.cue --
f: forall (A: int) func() -> _: {let hidden = A, value: hidden}
-- nested.cue --
f: forall (A: int) func() -> func() -> int: func() -> int: A
-- builtin.cue --
f: forall (A: string) func() -> int: len(A)
-- type_alias.cue --
Box(A) = {value: A}
f:
	forall (A: int) func() -> _: Box(A)
-- selection.cue --
id: forall (A) func(x: A) -> A: x
f:
	forall (A) func(x: A) -> A: id[A](x)
out: [f[1](1), f[2](2)]
-- alias_free.cue --
f: forall (A: int) func() -> int: {
	Hidden(B) = A
	out: Hidden(int)
}.out
left:  f[1] & f[2]
right: f[2] & f[1]
out:   [left(), right()]
-- alias_free_nested.cue --
f: forall (A: int) func() -> int: {
	Hidden(B) = A
	Wrap(C) = Hidden(C)
	out: Wrap(int)
}.out
-- alias_substitutions.cue --
Box(B) = B
f:
	forall (A: int) func() -> _: [Box(1), Box(A)]
-- fixed_alias.cue --
Box(A) = {value: A}
f:   func() -> {value: 1}: Box(1)
out: f().value
-- runtime_index.cue --
xs: [10, 20]
f:
	forall (A: int) func() -> int: xs[A]
out: f[0]()
