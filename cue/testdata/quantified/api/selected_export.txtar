// Selected function export preserves one implementation and all universal
// obligations, as well as the selected call view and partial type selection.

#skip
#inlinetest:exclude Run by cue/quantified_test.go for source round trips.

-- valid.cue --
id:       forall (A) func(x: A) -> A: x
selected: id[int]
-- invalid.cue --
bad:      forall (A) func(x: A) -> A: ({value: 0}).value
selected: bad[int]
-- partial.cue --
pair:     forall (A, B) func(x: A, y: B) -> [A, B]: [x, y]
selected: pair[int]
-- complete.cue --
pair:     forall (A, B) func(x: A, y: B) -> [A, B]: [x, y]
selected: pair[int][string]
-- attached.cue --
id(A): func(A) -> A
id: func(x: _) -> _: x
selected: id[int]
-- attached_partial.cue --
pair(A, B): func(A, B) -> [A, B]
pair: func(x: _, y: _) -> [_, _]: [x, y]
selected: pair[int]
