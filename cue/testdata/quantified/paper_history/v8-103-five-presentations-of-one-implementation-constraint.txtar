// Paper example 103: Five presentations of one implementation constraint

#noformat
#former-paper: 103
#mode: evaluation

-- paper.cue.txt --
positive: func(x: int) -> int: x & >0
positive: func(int) -> >0
-- in.cue --
@test(validate, concrete, at="positive")
@test(json, 3, at="ok")
@test(validate, conflict, at="bad")
@test(json, true, at="failed")

positive: func(x: int) -> int: x & >0
positive: func(int) -> >0

ok: positive(3)
bad: positive(0)
failed: bad == _|_
