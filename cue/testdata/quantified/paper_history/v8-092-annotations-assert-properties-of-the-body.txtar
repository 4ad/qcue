// Paper example 092: Annotations assert properties of the body

#noformat
#former-paper: 92
#mode: evaluation

-- paper.cue.txt --
id(A): func(x: A) -> A: x          // accepted
wrong(A): func(x: A) -> A: 0       // blocked: 0 is not arbitrary A
asText: func(x: int) -> string: x  // blocked: int does not imply string
asTwo: func(x: int) -> 2: 1        // refuted singleton obligation
stop(A): func(x: A) -> A: _|_      // explicit failure; no successful return
-- in.cue --
@test(validate, concrete, at="id")
@test(validate, blocked, at="wrong")
@test(validate, blocked, at="asText")
@test(validate, blocked, at="asTwo")
@test(validate, concrete, at="stop")
@test(json, true, at="failed")

id(A): func(x: A) -> A: x          // accepted
wrong(A): func(x: A) -> A: 0       // blocked: 0 is not arbitrary A
asText: func(x: int) -> string: x  // blocked: int does not imply string
asTwo: func(x: int) -> 2: 1        // refuted singleton obligation
stop(A): func(x: A) -> A: _|_      // explicit failure; no successful return

failed: stop(3) == _|_
