id:    func(int) -> int       // redundant instance

quiet(A): func(A) -> A
quiet:    func(int) -> bool   // invalid explicit interface on int
-- in.cue --
@test(validate, concrete, incomplete, at="id")
@test(validate, blocked, at="quiet")

