// Paper example 102: Five presentations of one implementation constraint

#noformat
#former-paper: 102
#mode: evaluation

-- paper.cue.txt --
positive: func(int) -> (int & >0)
positive: func(x: int) -> _: x & >0
-- in.cue --
@test(validate, concrete, at="positive")
@test(json, 3, at="ok")
@test(validate, conflict, at="bad")
@test(json, true, at="failed")

positive: func(int) -> (int & >0)
positive: func(x: int) -> _: x & >0

ok: positive(3)
bad: positive(0)
failed: bad == _|_
