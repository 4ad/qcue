// Paper example 107: Higher-order obligations are never runtime residuals

#noformat
#former-paper: 107
#mode: evaluation

-- paper.cue.txt --
apply: func(g: func(number) -> string) -> string: g(1.5)
ints: func(x: int) -> string: "ok"
blocked: apply(ints)         // blocked before execution

source: func(int) -> string // an unresolved external implementation
client: func() -> string: source(3)
-- in.cue --
@test(validate, concrete, at="apply")
@test(validate, concrete, at="ints")
@test(validate, blocked, at="blocked")
@test(validate, concrete, incomplete, at="source")
@test(validate, concrete, incomplete, at="client")

apply: func(g: func(number) -> string) -> string: g(1.5)
ints: func(x: int) -> string: "ok"
blocked: apply(ints)         // blocked before execution

source: func(int) -> string // an unresolved external implementation
client: func() -> string: source(3)
