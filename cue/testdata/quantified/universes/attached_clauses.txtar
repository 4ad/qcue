// Every retained telescope uses the same impredicative sort, including
// unused binders and self instances reached through attached clauses.

-- in.cue --
@test(validate, at="self")
@test(validate, at="baseSpelling")
@test(validate, at="higherSpelling")
@test(validate, at="compositeInstance")
@test(validate, at="nestedSelf")

f:          func(x: _) -> _: x
f:          forall (A) func(A) -> A
self:       f[f](f)
nestedSelf: f[{value: f}]

g: func(x: _) -> _: x
g: forall (A) func(A) -> A
Box(A) = {value: A}
Large(A) = {value: A}
baseSpelling:    Box(g)
higherSpelling: Large(g)

composite:         forall (A) {}
compositeInstance: Box(composite)
