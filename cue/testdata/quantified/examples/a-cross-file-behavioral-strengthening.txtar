-- in.cue --
@test(json, {"value":3,"tag":"wrapped"}, at="probe")

// interface.cue
wrap:
	forall (A) func(A) -> {value: A}

// metadata.cue
wrap:
	forall (A) func(A) -> {tag: "wrapped"}

// implementation.cue
wrap:
	forall (A) func(x: A) -> {value: A, tag: "wrapped"}: {
		value: x
		tag:   "wrapped"
	}

probe: wrap(3)
