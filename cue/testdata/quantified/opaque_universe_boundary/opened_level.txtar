// Opaque witnesses and their singleton values use the same impredicative
// sort. Legacy Type(n) spellings no longer restrict their instance types.

-- in.cue --
@test(validate, concrete, at="p")
@test(json, true, at="typeInstance")
@test(json, true, at="valueInstance")
@test(json, true, at="recordInstance")
@test(json, true, at="inferredInstance")
@test(json, true, at="declaredInstance")
@test(json, [true, true, true], at="good")

#Poly: forall (B in Type(0)) func(B) -> B
#I:    exists (A in Type(1)) {value: A}
p: seal #I with (A = #Poly) {
	value: forall (B in Type(0)) func(x: B) -> B: x
}
Base(T in Type(0)) = true
Higher(T in Type(1)) = true
typeInstance:   (open p as (A, P) {x: Base(A)}).x
valueInstance:  (open p as (A, P) {x: Base(P.value)}).x
recordInstance: (open p as (A, P) {x: Base({value: A})}).x

#Inferred: exists (A) {value: A}
inferred: seal #Inferred with (A = #Poly) {
	value: forall (B in Type(0)) func(x: B) -> B: x
}
inferredInstance: (open inferred as (A, P) {x: Base(A)}).x
declared:    seal #I with (A = int) {value: 1}
declaredInstance: (open declared as (A, P) {x: Base(A)}).x
base:        seal #Inferred with (A = int) {value: 1}
good: [
	(open p as (A, P) {x: Higher(A)}).x,
	(open p as (A, P) {x: Higher(P.value)}).x,
	(open base as (A, P) {x: Base(A)}).x,
]
