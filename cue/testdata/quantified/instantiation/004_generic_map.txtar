Quantified CUE: Instantiation/generic map

-- in.cue --
@test(json, [[2,3,4],["1","2","3"]], at="out")

map(A, B): func(g: func(A) -> B, xs: [...A]) -> [...B]: [
    for x in xs {g(x)}
]
inc: func(x: int) -> int: x + 1
text: func(x: int) -> string: "\(x)"
out: [map(inc, [1, 2, 3]), map(text, [1, 2, 3])]
