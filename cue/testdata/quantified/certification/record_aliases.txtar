// Lexical type abbreviations do not add required fields to a record type.
// Their uses still constrain the corresponding fields, including nested ones.

-- in.cue --
@test(validate, concrete, incomplete, at="out")
@test(json, 3, at="out[0]")
@test(json, 5, at="out[2]")
@test(json, 6, at="out[3]")
@test(validate, conflict, at="wrong")
@test(validate, concrete, incomplete, at="missing")
@test(validate, conflict, at="wrongNested")

get: func(r: {let N = int, a: N}) -> int: r.a
nested: func(r: {let N = int, v: {a: N}}) -> int: r.v.a
closed: func(r: close({a: int})) -> int: r.a
out: [get({a: 3}), get({let N = string, a: 4, extra: N}),
	nested({v: {a: 5}}), closed({let N = int, a: N & 6})]
wrong: get({a: "three"})
missing: get({})
wrongNested: nested({v: {a: "five"}})
