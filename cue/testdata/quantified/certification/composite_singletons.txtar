// Ordinary references in signatures denote exact witnesses, recursively.

-- in.cue --
@test(validate, conflict, at="extra")
@test(validate, conflict, at="missing")
@test(validate, conflict, at="nestedExtra")
@test(validate, conflict, at="listExtra")
@test(json, [{x: 1}, {inner: {x: 1}}, [{x: 1}]], at="good")

a: {x: 1}
n: {inner: a}
l: [a]
extra:       (func() -> a: {x: 1, y: 2})()
missing:     (func() -> a: {})()
nestedExtra: (func() -> n: {inner: {x: 1, y: 2}})()
listExtra:   (func() -> l: [{x: 1, y: 2}])()
good: [(func() -> a: {x: 1})(), (func() -> n: {inner: {x: 1}})(), (func() -> l: [{x: 1}])()]
