-- in.cue --
@test(validate, concrete, incomplete, at="badResult")
@test(validate, concrete, incomplete, at="badDomain")
@test(validate, concrete, incomplete, at="badDefault")
@test(validate, concrete, incomplete, at="badLabel")
@test(validate, concrete, at="good")
@test(validate, concrete, at="singleton")
@test(validate, concrete, at="named")
@test(validate, conflict, at="counterexample")
@test(validate, conflict, at="omitted")
@test(validate, conflict, at="relabeled")
@test(json, ["A", "B", "C"], at="out")
@test(validate, concrete, at="length")
@test(json, [3, 1], at="lengths")

import "strings"

badResult: strings.ToUpper & (func(string) -> "bad")
badDomain: strings.ToUpper & (func(string | int) -> string)
badDefault: strings.ToUpper & (func(string = "abc") -> string)
badLabel: strings.ToUpper & (func(renamed: string) -> string)
good: strings.ToUpper & (func(string) -> string)
singleton: strings.ToUpper & (func("a") -> "A")
named: strings.ToUpper & (func(s!: "c") -> "C")
counterexample: badResult("x")
omitted: badDefault()
relabeled: badLabel(renamed: "x")
out: [singleton("a"), singleton("b"), named(s: "c")]
length: len & (func("abc") -> 3)
lengths: [length("abc"), length("a")]
