Result inclusion must preserve required fields. Neither a top-valued
required field nor a closed candidate makes the presence obligation vacuous.

-- in.cue --
@test(validate, concrete, incomplete, at="closedMissing")
@test(validate, concrete, incomplete, at="topMissing")
@test(validate, concrete, incomplete, at="optionalMissing")
@test(validate, concrete, at="present")
@test(validate, concrete, at="optional")
@test(validate, conflict, at="badClosed")
@test(validate, concrete, incomplete, at="badTop")
@test(json, {a: 1}, at="good")
@test(subsume, requiredType, closedType, fail)
@test(subsume, requiredTopType, emptyType, fail)

#Empty: {}
closedMissing: func() -> {a!: int}: #Empty
topMissing: func() -> {a!: _}: {}
optionalMissing: func(x: {a?: _}) -> {a!: _}: x
present: func() -> {a!: int}: {a: 1}
optional: func() -> {a?: int}: #Empty
badClosed: closedMissing()
badTop: topMissing()
good: present()
requiredType: func() -> {a!: int}
closedType: func() -> #Empty
requiredTopType: func() -> {a!: _}
emptyType: func() -> {}
