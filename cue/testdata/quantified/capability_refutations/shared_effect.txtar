// Common admitted failure outcomes do not satisfy the explicit interface's
// successful observations. Relevance blocks these descriptions, including
// unimplemented and generic declarations, independently of their effect tags.

-- in.cue --
@test(validate, blocked, at="shared")
@test(validate, blocked, at="generic")
@test(validate, blocked, at="pure")
@test(validate, blocked, at="different")
@test(validate, blocked, at="refined")

shared: (func(int) -> int !bridge) & (func(int) -> string !bridge)
generic:
	forall (A) (func(A) -> int !bridge) & (func(A) -> string !bridge)
pure:      (func(int) -> int) & (func(int) -> string !bridge)
different: (func(int) -> int !bridge) & (func(int) -> string !decode)
refined:   shared & (func(int) -> int)
