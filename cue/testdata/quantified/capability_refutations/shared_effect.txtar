// Intersecting effectful arrows retains their common admitted failure outcome.
// An unspecified implementation is still incomplete; a pure obligation or
// disjoint effect tags can rule out the shared outcome and establish conflict.

-- in.cue --
@test(validate, at="shared")
@test(validate, concrete, incomplete, at="shared")
@test(validate, at="generic")
@test(validate, concrete, incomplete, at="generic")
@test(validate, conflict, at="pure")
@test(validate, conflict, at="different")
@test(validate, conflict, at="refined")

shared: (func(int) -> int !bridge) & (func(int) -> string !bridge)
generic:
	forall (A) (func(A) -> int !bridge) & (func(A) -> string !bridge)
pure:      (func(int) -> int) & (func(int) -> string !bridge)
different: (func(int) -> int !bridge) & (func(int) -> string !decode)
refined:   shared & (func(int) -> int)
