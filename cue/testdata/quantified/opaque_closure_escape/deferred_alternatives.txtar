Opening scopes survive optional-field materialization and selection of a
closure from a union. Ordinary data results, absent fields, and preference
selection remain valid.

-- in.cue --
@test(validate, conflict, at="optionalOut")
@test(validate, conflict, at="unionOut")
@test(validate, conflict, at="preferredOut")
@test(validate, conflict, at="patternOut")
@test(validate, conflict, at="listOut")
@test(validate, concrete, at="absent")
@test(json, 7, at="dataOut")
@test(json, 0, at="ordinaryOut")
@test(json, "word", at="labelOut")

#P: exists A {value: A}
p: seal #P with (A = int) {value: 42}
optional: open p as (A, P) {get?: func(): P.value}
optional: {get: _}
optionalOut: optional.get()

#union: open p as (A, P) {get: (func(): P.value) | 0}
selected: #union.get & (func() -> _)
unionOut: selected()

#preferred: open p as (A, P) {get: *(func(): P.value) | 0}
preferredOut: #preferred.get()
absent: open p as (A, P) {get?: func(): P.value}
data: open p as (A, P) {get?: func() -> int: 7}
data: {get: _}
dataOut: data.get()
ordinaryOut: #union.get & 0

patterns: open p as (A, P) {[string]: func(): P.value}
patterns: {get: _}
patternOut: patterns.get()
lists: open p as (A, P) {get: [...(func(): P.value)]}
lists: {get: [_]}
listOut: lists.get[0]()
labels: open p as (A, P) {[string]~(L,_): func() -> string: L}
labels: {word: _}
labelOut: labels.word()
