// Ordinary open-record packets and results preserve their extra data fields.
// Only the module's private declarations are projected at the sealing root.

-- in.cue --
@test(json, [1, {a: 1}, 1, 1, 7, 9], at="out")
@test(validate, concrete, at="p")
@test(validate, concrete, incomplete, at="hidden")

#I: exists A {
	v: A
	count: func({}) -> int
	make: func() -> {}
	nested: func({inner: {}}) -> int
	list: func([{}]) -> int
	echo: func({v: A}) -> {v: A}
	read: func(A) -> int
}
p: seal #I with (A = int) {
	v: 7
	secret: "private declaration"
	count: func(x: {}) -> int: len(x)
	make: func() -> {}: {a: 1}
	nested: func(x: {inner: {}}) -> int: len(x.inner)
	list: func(x: [{}]) -> int: len(x[0])
	echo: func(x: {v: int}) -> {v: int}: x
	read: func(x: int) -> int: x
}
out: (open p as (A, P) {
	let packet = P.echo({v: P.v, extra: 9})
	r: [P.count({a: 1}), P.make(), P.nested({inner: {a: 1}}),
		P.list([{a: 1}]), P.read(packet.v), packet.extra]
}).r
hidden: (open p as (A, P) {r: P.secret}).r
