// Definition checking proves functions inside records and lists. The shared
// integer interval rule certifies each sibling separately. Schema declarations
// alone do not require an implementation until concrete observation.

-- in.cue --
@test(validate)
@test(validate, concrete, at="record")
@test(validate, concrete, at="items")
@test(validate, concrete, at="instance")
@test(validate, concrete, at="schemaOnly")
record: {
	f: func(x: int & >0) -> (int & >=0): x - 1
	g: func(y: int & >0) -> (int & >=0): y - 1
}
items:      [record.f]
#Schema:    {operation: func(int) -> int}
instance:   #Schema & {operation: func(x: int) -> int: x}
schemaOnly: {#Function: func(int) -> int, optional?: func(int) -> int}
