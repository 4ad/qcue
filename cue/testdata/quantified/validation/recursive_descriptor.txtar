// A recursive closure has a complete identity and a partial-correctness
// certificate. Finite conditional branches establish the result's presence.

-- in.cue --
@test(validate)
@test(validate, concrete, at="f")
@test(json, 3, at="observation")
f: func(xs: [...int]) -> int: ({
	if len(xs) == 0 {out: 0}
	if len(xs) > 0 {out: xs[0] + f(xs[1:])}
}).out
observation: f([1, 2])
