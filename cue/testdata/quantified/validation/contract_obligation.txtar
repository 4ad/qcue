// Integer interval translation establishes this contract before any call:
// x > 0 implies x >= 1, and therefore x - 1 >= 0.

-- in.cue --
@test(validate)
@test(validate, concrete)
@test(validate, concrete, at="positive")
@test(json, 0, at="observation")
positive:    func(x: int & >0) -> (int & >=0): x - 1
observation: positive(1)
