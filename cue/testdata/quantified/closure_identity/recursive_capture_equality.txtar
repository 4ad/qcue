// A self capture is a closure, so this body cannot establish its string
// result. Static checking blocks the call before cyclic identity observation.

-- in.cue --
@test(validate, blocked, at="out")

#P:     exists (A) {value: A}
p:      seal #P with (A = int) {value: 42}
labels: open p as (A, P) {[string]~(Self): func() -> string: Self}
labels: {word: _}
out:    labels.word()
