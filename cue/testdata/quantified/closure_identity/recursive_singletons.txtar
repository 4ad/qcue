// A cyclic comparison of concrete closure descriptors is an unresolved
// singleton obligation, not evidence that the witnesses are different.

-- in.cue --
@test(validate, concrete, incomplete, at="out")

#C: {cb: func() -> _, f: func() -> _: cb}
a: #C & {cb: a.f}
b: #C & {cb: b.f}
witness: {f: a.f}
accept: func(x: witness) -> int: 1
out: accept({f: b.f})
