// Paper example 032: Mapping named record coordinates

#noformat
#paper: 32
#mode: evaluation

-- paper.cue.txt --
mapPoint(A, B): func(g: func(A) -> B, p: {x: A, y: A}) -> {
    x: B
    y: B
}: {
    x: g(p.x)
    y: g(p.y)
}
p: mapPoint(text, {x: 2, y: 3}) // {x: "2", y: "3"}
-- in.cue --
@test(json, {"x":"2","y":"3"}, at="p")

text: func(x: int) -> string: "\(x)"
mapPoint(A, B): func(g: func(A) -> B, p: {x: A, y: A}) -> {
    x: B
    y: B
}: {
    x: g(p.x)
    y: g(p.y)
}
p: mapPoint(text, {x: 2, y: 3}) // {x: "2", y: "3"}
