// Paper example 048: Errors distinguish presence from values

#noformat
#paper: 48
#mode: evaluation

-- paper.cue.txt --
a: sum(1, a: 1)            // duplicate binding, even with equal values
b: sum(1, 2, 3)            // surplus positional argument
c: sum(a: 1, b: 2, c: 3)    // unknown label
d: sum(1)                  // required argument missing
e: sum(_, 2)               // supplied but incomplete, not missing
-- in.cue --
@test(validate, conflict, at="a")
@test(validate, conflict, at="b")
@test(validate, conflict, at="c")
@test(validate, conflict, at="d")
// The supplied top value cannot establish integer packet membership yet.
// This is a blocked static judgment, not a missing-argument error.
@test(validate, blocked, at="e")

sum: func(a: int, b: int) -> int: a + b
a: sum(1, a: 1)            // duplicate binding, even with equal values
b: sum(1, 2, 3)            // surplus positional argument
c: sum(a: 1, b: 2, c: 3)    // unknown label
d: sum(1)                  // required argument missing
e: sum(_, 2)               // supplied but incomplete, not missing
