// Paper example 091: A broad approximation is not a contradiction

#noformat
#paper: 91
#mode: evaluation

-- paper.cue.txt --
f: func(x: number) -> number: 1
f: func(number) -> int              // provable from the body

unknown: func(number) -> number
unknown: func(number) -> int        // a nonempty refinement
-- in.cue --
@test(validate, at="f")
@test(validate, at="unknown")

f: func(x: number) -> number: 1
f: func(number) -> int              // provable from the body

unknown: func(number) -> number
unknown: func(number) -> int        // a nonempty refinement
