// Paper example 041: Positional, named, and mixed calls

#noformat
#paper: 41
#mode: evaluation

-- paper.cue.txt --
sum: func(a: int, b: int) -> int: a + b
p: sum(2, 3)                // 5
q: sum(a: 2, b: 3)          // 5
r: sum(2, b: 3)             // 5
-- in.cue --
@test(json, 5, at="p")
@test(json, 5, at="q")
@test(json, 5, at="r")

sum: func(a: int, b: int) -> int: a + b
p: sum(2, 3)                // 5
q: sum(a: 2, b: 3)          // 5
r: sum(2, b: 3)             // 5
