Paper example 048: A configurable default is an explicit adapter

#paper: 48
#mode: evaluation

-- paper.cue.txt --
raw: func(x: int) -> int: x
configured: func(x: int = 2) -> int: raw(x)
answer: configured()        // 2
-- in.cue --
@test(json, 2, at="answer")

raw: func(x: int) -> int: x
configured: func(x: int = 2) -> int: raw(x)
answer: configured()        // 2
