// Paper example 080: A shared hidden representation

#noformat
#paper: 80
#mode: evaluation

-- paper.cue.txt --
#Counter: exists State {
    zero: State
    next: func(State) -> State
    read: func(State) -> (int & >=0)
}
-- in.cue --
@test(validate, at="#Counter")

#Counter: exists State {
    zero: State
    next: func(State) -> State
    read: func(State) -> (int & >=0)
}
