Paper example 038: A cross-file behavioral strengthening

#paper: 38
#mode: evaluation

-- paper.cue.txt --
// interface.cue
wrap(A): func(A) -> {value: A}

// metadata.cue
wrap(A): func(A) -> {tag: "wrapped"}

// implementation.cue
wrap(A): func(x: A) -> {value: A, tag: "wrapped"}: {
    value: x
    tag: "wrapped"
}
-- in.cue --
@test(json, {"value":3,"tag":"wrapped"}, at="probe")

// interface.cue
wrap(A): func(A) -> {value: A}

// metadata.cue
wrap(A): func(A) -> {tag: "wrapped"}

// implementation.cue
wrap(A): func(x: A) -> {value: A, tag: "wrapped"}: {
    value: x
    tag: "wrapped"
}

probe: wrap(3)
