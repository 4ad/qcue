// Paper example 040: Defaults belong to the protocol

#noformat
#paper: 40
#mode: evaluation

-- paper.cue.txt --
add: func(a: int, b: int = 10) -> int: a + b
x: int | *5
omitted:  add(1)             // 11
supplied: add(1, x)          // 6
unknown:  add(1, _)          // incomplete
render: func(text: string, suffix!: string = "!") -> string:
    text + suffix
hello: render("hello")                 // "hello!"
question: render("hello", suffix: "?") // "hello?"
badDefault: func(x: int = "x") -> int: x // rejected
-- in.cue --
@test(json, 11, at="omitted")
@test(json, 6, at="supplied")
@test(validate, concrete, incomplete, at="unknown")
@test(json, "hello!", at="hello")
@test(json, "hello?", at="question")
@test(validate, conflict, at="badDefault")

add: func(a: int, b: int = 10) -> int: a + b
x: int | *5
omitted:  add(1)             // 11
supplied: add(1, x)          // 6
unknown:  add(1, _)          // incomplete
render: func(text: string, suffix!: string = "!") -> string:
    text + suffix
hello: render("hello")                 // "hello!"
question: render("hello", suffix: "?") // "hello?"
badDefault: func(x: int = "x") -> int: x // rejected
