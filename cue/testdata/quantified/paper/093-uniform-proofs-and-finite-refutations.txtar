// Paper example 093: Uniform proofs and finite refutations

#noformat
#paper: 93
#mode: evaluation

-- paper.cue.txt --
id(A): func(x: A) -> A: x        // one structural proof
bad(A): func(x: A) -> A: 0      // refuted at A = 1, x = 1
-- in.cue --
@test(validate, conflict, at="bad")
@test(validate, at="id")

id(A): func(x: A) -> A: x        // one structural proof
bad(A): func(x: A) -> A: 0      // refuted at A = 1, x = 1
