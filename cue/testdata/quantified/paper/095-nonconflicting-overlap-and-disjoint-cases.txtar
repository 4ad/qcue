// Paper example 095: Nonconflicting overlap and disjoint cases

#noformat
#paper: 95
#mode: evaluation

-- paper.cue.txt --
a: (func(number) -> number) & (func(int) -> int)
// accepted interface: integers on int, numbers on other numeric inputs

b: (func(int) -> string) & (func(string) -> int)
// accepted interface: the two domains are disjoint

c: (func(int) -> (0 | 1)) &
   (func(int) -> (1 | 2)) &
   (func(int) -> (0 | 2))
// blocked: all three results have empty intersection on int
-- in.cue --
@test(validate, concrete, incomplete, at="a")
@test(validate, concrete, incomplete, at="b")
@test(validate, blocked, at="c")

a: (func(number) -> number) & (func(int) -> int)
// accepted interface: integers on int, numbers on other numeric inputs

b: (func(int) -> string) & (func(string) -> int)
// accepted interface: the two domains are disjoint

c: (func(int) -> (0 | 1)) &
   (func(int) -> (1 | 2)) &
   (func(int) -> (0 | 2))
// blocked: all three results have empty intersection on int
