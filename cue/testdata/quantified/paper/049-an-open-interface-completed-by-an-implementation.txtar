// Paper example 049: An open interface completed by an implementation

#noformat
#paper: 49
#mode: evaluation

-- paper.cue.txt --
T: func(a: int, ...) -> number
f: T & (func(a: int, b: int) -> int: a + b)
x: f(1, 2)                 // 3
y: f(1)                    // missing b
-- in.cue --
@test(json, 3, at="x")
@test(validate, conflict, at="y")

T: func(a: int, ...) -> number
f: T & (func(a: int, b: int) -> int: a + b)
x: f(1, 2)                 // 3
y: f(1)                    // missing b
