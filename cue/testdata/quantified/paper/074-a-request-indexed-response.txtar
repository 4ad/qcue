Paper example 074: A request-indexed response

#paper: 74
#mode: evaluation
#inlinetest:exclude Not an executable S_H/A example; see TestQuantifiedPaperIndex.
#skip
Dependent profile D (out of scope).

-- paper.cue.txt --
let Request = {kind: "lookup", key: string} |
              {kind: "size", items: [..._]}
Reply(q in Request) = {
    if q.kind == "lookup" {result: string}
    if q.kind == "size"   {result: int & >=0}
}
request: extern func(q: Request) -> Reply(q) !service
