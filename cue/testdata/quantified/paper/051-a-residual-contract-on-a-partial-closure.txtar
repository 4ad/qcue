Paper example 051: A residual contract on a partial closure

#paper: 51
#mode: evaluation

-- paper.cue.txt --
f: add3(1, ...)
f: func(int, int) -> int
x: f(2, 3)                 // 6
-- in.cue --
@test(json, 6, at="x")

add3: func(a: int, b: int, c: int) -> int: a + b + c
f: add3(1, ...)
f: func(int, int) -> int
x: f(2, 3)                 // 6
