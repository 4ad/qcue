Paper example 092: Concrete counterexamples to implementation contracts

#paper: 92
#mode: evaluation

-- paper.cue.txt --
wrongResult: func(int) -> string
wrongResult: func(x: int) -> int: x

wrongDomain: func(number) -> string
wrongDomain: func(x: int) -> string: "ok"
-- in.cue --
@test(validate, conflict, at="wrongDomain")
@test(validate, conflict, at="wrongResult")

wrongResult: func(int) -> string
wrongResult: func(x: int) -> int: x

wrongDomain: func(number) -> string
wrongDomain: func(x: int) -> string: "ok"
