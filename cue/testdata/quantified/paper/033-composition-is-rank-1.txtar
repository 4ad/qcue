Paper example 033: Composition is rank-1

#paper: 33
#mode: evaluation

-- paper.cue.txt --
compose(A, B, C): func(g: func(B) -> C, f: func(A) -> B) ->
    func(A) -> C:
    func(x: A) -> C: g(f(x))

pipeline: compose(text, inc)
answer: pipeline(4)           // "5"
-- in.cue --
@test(json, "5", at="answer")

text: func(x: int) -> string: "\(x)"
inc: func(x: int) -> int: x + 1
compose(A, B, C): func(g: func(B) -> C, f: func(A) -> B) ->
    func(A) -> C:
    func(x: A) -> C: g(f(x))

pipeline: compose(text, inc)
answer: pipeline(4)           // "5"
