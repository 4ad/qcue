// Paper example 037: A reusable polymorphic utility record

#noformat
#paper: 37
#mode: evaluation

-- paper.cue.txt --
utilities(A): {
    id:   func(x: A) -> A: x
    wrap: func(x: A) -> {value: A}: {value: x}
}
utilities: {name: "core"}

wrapped: utilities.wrap("payload") // {value: "payload"}
-- in.cue --
@test(json, {"value":"payload"}, at="wrapped")

utilities(A): {
    id:   func(x: A) -> A: x
    wrap: func(x: A) -> {value: A}: {value: x}
}
utilities: {name: "core"}

wrapped: utilities.wrap("payload") // {value: "payload"}
