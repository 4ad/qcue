Paper example 087: Mixed prefixes and generic modules

#paper: 87
#mode: evaluation

-- paper.cue.txt --
module(A): {
    exists State
    empty: State
    push: func(A, State) -> State
}
-- in.cue --
@test(validate, at="module")

module(A): {
    exists State
    empty: State
    push: func(A, State) -> State
}
