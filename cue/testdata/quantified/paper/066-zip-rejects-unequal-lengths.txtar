// Paper example 066: Zip rejects unequal lengths

#noformat
#paper: 66
#mode: evaluation
#inlinetest:exclude Not an executable S_H/A example; see TestQuantifiedPaperIndex.
#skip
Dependent profile D (out of scope).

-- paper.cue.txt --
zip(A, B, n in Nat): func(xs: Vec(A, n), ys: Vec(B, n)) ->
    Vec([A, B], n): [for i, x in xs {[x, ys[i]]}]

z: zip([1, 2], ["a", "b"]) // [[1, "a"], [2, "b"]]
bad: zip([1], ["a", "b"])   // inconsistent length witness
