Dependent profile D (out of scope).

-- paper.cue.txt --
index(A, n in Nat): func(xs: Vec(A, n), i: Fin(n)) -> A: xs[i]

x: index(["a", "b"], 1)    // "b"
bad: index([], 0)           // 0 is outside Fin(0)
