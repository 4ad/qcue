// Paper example 057: Nested calls remain ordinary evaluation

#noformat
#paper: 57
#mode: evaluation

-- paper.cue.txt --
twice: func(n: int) -> int: n + n
value: twice(twice(twice(2))) // 16
-- in.cue --
@test(json, 16, at="value")

twice: func(n: int) -> int: n + n
value: twice(twice(twice(2))) // 16
