Dependent profile D (out of scope).

-- paper.cue.txt --
append(A, n in Nat, m in Nat): func(
    xs: Vec(A, n), ys: Vec(A, m),
) -> Vec(A, n + m): [for x in xs {x}, for y in ys {y}]

v: append([1, 2], [3])      // [1, 2, 3]
