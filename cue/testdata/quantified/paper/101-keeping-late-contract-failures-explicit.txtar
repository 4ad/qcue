Paper example 101: Keeping late contract failures explicit

#paper: 101
#mode: evaluation

-- paper.cue.txt --
checked: func(x: int) -> string !constraint:
    checkedResult(string, legacyBody(x))
-- in.cue --
@test(validate, at="checked")

checkedResult: extern func(_, _) -> _ !constraint
legacyBody: extern func(int) -> _ !constraint
checked: func(x: int) -> string !constraint:
    checkedResult(string, legacyBody(x))
