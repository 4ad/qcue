Paper example 028: Two type parameters preserve asymmetric information

#paper: 28
#mode: evaluation

-- paper.cue.txt --
swap(A, B): func(p: [A, B]) -> [B, A]: [p[1], p[0]]
s: swap([7, "seven"])         // ["seven", 7]
-- in.cue --
@test(json, ["seven",7], at="s")

swap(A, B): func(p: [A, B]) -> [B, A]: [p[1], p[0]]
s: swap([7, "seven"])         // ["seven", 7]
