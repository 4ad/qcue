// Paper example 079: An integer representation

#noformat
#paper: 79
#mode: evaluation

-- paper.cue.txt --
counterV1: seal #Counter with (State = int & >=0) {
    zero: 0
    next: func(x: int & >=0) -> (int & >=0): x + 1
    read: func(x: int & >=0) -> (int & >=0): x
}
-- in.cue --
@test(json, 1, at="probe")

#Counter: exists State {
    zero: State
    next: func(State) -> State
    read: func(State) -> (int & >=0)
}
counterV1: seal #Counter with (State = int & >=0) {
    zero: 0
    next: func(x: int & >=0) -> (int & >=0): x + 1
    read: func(x: int & >=0) -> (int & >=0): x
}

probe: (open counterV1 as (S, C) {out: C.read(C.next(C.zero))}).out
