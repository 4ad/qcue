// Paper example 024: Full symmetric, higher-rank CUE: S_H

#noformat
#paper: 24
#mode: evaluation

-- paper.cue.txt --
use: func(forall A func(A) -> A) -> [int, string]

#Showable: exists A {
    value: A
    show:  func(A) -> string
}
show: func(#Showable) -> string
-- in.cue --
@test(validate, at="use")

use: func(forall A func(A) -> A) -> [int, string]

#Showable: exists A {
    value: A
    show:  func(A) -> string
}
show: func(#Showable) -> string
