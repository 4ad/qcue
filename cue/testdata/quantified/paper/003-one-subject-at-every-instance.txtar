Paper example 003: One subject at every instance

#paper: 3
#mode: evaluation

-- paper.cue.txt --
empty(A): [...A]                 // []
impossible(A): A                 // _|_
impossibleRecord(n in 0 | 1): {
    value: n                     // one field cannot be both 0 and 1
}
-- in.cue --
@test(json, [], at="empty")
@test(validate, conflict, at="impossible")
@test(validate, conflict, at="impossibleRecord")

empty(A): [...A]                 // []
impossible(A): A                 // _|_
impossibleRecord(n in 0 | 1): {
    value: n                     // one field cannot be both 0 and 1
}
