// Paper example 006: Common predicates and preserved refinements

#noformat
#paper: 6
#mode: evaluation

-- paper.cue.txt --
pair(A: number): func(x: A, y: A) -> [A, A]: [x, y]
p: pair[int & >=1](2, 5)       // [2, 5]
q: pair(1, 2.5)                // [1, 2.5]
bad: pair[int](1, 2.5)         // rejected: second argument is not int
swap(A, B): func(p: [A, B]) -> [B, A]: [p[1], p[0]]
s: swap([7, "seven"])          // ["seven", 7]
-- in.cue --
@test(json, [2,5], at="p")
@test(json, [1,2.5], at="q")
@test(validate, conflict, at="bad")
@test(json, ["seven",7], at="s")

pair(A: number): func(x: A, y: A) -> [A, A]: [x, y]
p: pair[int & >=1](2, 5)       // [2, 5]
q: pair(1, 2.5)                // [1, 2.5]
bad: pair[int](1, 2.5)         // rejected: second argument is not int
swap(A, B): func(p: [A, B]) -> [B, A]: [p[1], p[0]]
s: swap([7, "seven"])          // ["seven", 7]
