Paper example 083: Heterogeneous values with their own operations

#paper: 83
#mode: evaluation

-- paper.cue.txt --
#Showable: exists A {
    value: A
    show: func(A) -> string
}
p: seal #Showable with (A = int) {
    value: 7
    show: func(x: int) -> string: "\(x)"
}
q: seal #Showable with (A = string) {
    value: "hello"
    show: func(x: string) -> string: x
}
items: [p, q]
-- in.cue --
@test(validate, at="items")

#Showable: exists A {
    value: A
    show: func(A) -> string
}
p: seal #Showable with (A = int) {
    value: 7
    show: func(x: int) -> string: "\(x)"
}
q: seal #Showable with (A = string) {
    value: "hello"
    show: func(x: string) -> string: x
}
items: [p, q]
