Paper example 050: Chained partial application

#paper: 50
#mode: evaluation

-- paper.cue.txt --
add3: func(a: int, b: int, c: int) -> int: a + b + c
f: add3(1, ...)
g: f(2, ...)
x: g(3)                    // 6
y: add3(a: 1, ...)(2, 3)    // 6
-- in.cue --
@test(json, 6, at="x")
@test(json, 6, at="y")

add3: func(a: int, b: int, c: int) -> int: a + b + c
f: add3(1, ...)
g: f(2, ...)
x: g(3)                    // 6
y: add3(a: 1, ...)(2, 3)    // 6
