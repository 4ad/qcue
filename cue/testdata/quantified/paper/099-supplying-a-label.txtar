// Paper example 099: Supplying a label

#noformat
#paper: 99
#mode: evaluation

-- paper.cue.txt --
raw: func(_~n: int) -> int: n + 1
named: func(x: int) -> int: raw(x)
a: named(x: 2)              // 3
-- in.cue --
@test(json, 3, at="a")

raw: func(_~n: int) -> int: n + 1
named: func(x: int) -> int: raw(x)
a: named(x: 2)              // 3
