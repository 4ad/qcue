Paper example 002: Independent instantiations of a description

#paper: 2
#mode: evaluation

-- paper.cue.txt --
#Cell: {value: int}
left:  #Cell & {value: 1}
right: #Cell & {value: 2}
-- in.cue --
@test(json, {"value":1}, at="left")
@test(json, {"value":2}, at="right")

#Cell: {value: int}
left:  #Cell & {value: 1}
right: #Cell & {value: 2}
