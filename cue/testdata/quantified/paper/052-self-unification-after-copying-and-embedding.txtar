// Paper example 052: Self-unification after copying and embedding

#noformat
#paper: 52
#mode: evaluation

-- paper.cue.txt --
x: {f: func(y: int) -> int: y}
a: x.f & x.f
b: x.f & {x}.f
c: x.f & (x & {g: 1}).f
r: [a(2), b(2), c(2)]       // [2, 2, 2]
-- in.cue --
@test(json, [2,2,2], at="r")

x: {f: func(y: int) -> int: y}
a: x.f & x.f
b: x.f & {x}.f
c: x.f & (x & {g: 1}).f
r: [a(2), b(2), c(2)]       // [2, 2, 2]
