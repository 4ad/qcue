// Paper example 020: Parametric aliases

#noformat
#paper: 20
#mode: evaluation

-- paper.cue.txt --
Box(A) = {value: A}
Pair(A, B) = [A, B]
-- in.cue --
@test(json, {"b":{"value":3},"p":[3,"x"]}, at="probe")

Box(A) = {value: A}
Pair(A, B) = [A, B]

probe: {b: Box(int) & {value: 3}, p: Pair(int, string) & [3, "x"]}
