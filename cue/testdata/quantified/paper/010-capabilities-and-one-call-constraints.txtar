// Paper example 010: Capabilities and one-call constraints

#noformat
#paper: 10
#mode: evaluation

-- paper.cue.txt --
wide:   func(number) -> string
wide:   func(x: int) -> string: "ok"  // blocked: static domain mismatch

narrow: func(int) -> string
narrow: func(x: number) -> string: "ok" // conforming implementation
-- in.cue --
@test(validate, blocked, at="wide")
@test(validate, concrete, at="narrow")
@test(json, "ok", at="out")

wide:   func(number) -> string
wide:   func(x: int) -> string: "ok"  // blocked: static domain mismatch

narrow: func(int) -> string
narrow: func(x: number) -> string: "ok" // conforming implementation

out: narrow(3)
