// Paper example 016: Quantifier blocks

#noformat
#paper: 16
#mode: evaluation

-- paper.cue.txt --
x: {
    exists T: U
    forall V: W
    // The whole following declaration body is in this prefix.
    value: T
    transform: func(V) -> V
}
-- in.cue --
@test(validate, at="x")

U: _
W: _
x: {
    exists T: U
    forall V: W
    // The whole following declaration body is in this prefix.
    value: T
    transform: func(V) -> V
}
