Paper example 086: An abstract codec interface

#paper: 86
#mode: evaluation

-- paper.cue.txt --
#CodecModule: exists Value {
    encode: func(Value) -> bytes
    decode: func(bytes) -> Value !decode
}
-- in.cue --
@test(validate, at="#CodecModule")

#CodecModule: exists Value {
    encode: func(Value) -> bytes
    decode: func(bytes) -> Value !decode
}
