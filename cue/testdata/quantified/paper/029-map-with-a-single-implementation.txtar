Paper example 029: Map with a single implementation

#paper: 29
#mode: evaluation

-- paper.cue.txt --
map(A, B): func(g: func(A) -> B, xs: [...A]) -> [...B]: [
    for x in xs {g(x)}
]
inc:  func(x: int) -> int: x + 1
text: func(x: int) -> string: "\(x)"

numbers: map(inc, [1, 2, 3])    // [2, 3, 4]
strings: map(text, [1, 2, 3])   // ["1", "2", "3"]
-- in.cue --
@test(json, [2,3,4], at="numbers")
@test(json, ["1","2","3"], at="strings")

map(A, B): func(g: func(A) -> B, xs: [...A]) -> [...B]: [
    for x in xs {g(x)}
]
inc:  func(x: int) -> int: x + 1
text: func(x: int) -> string: "\(x)"

numbers: map(inc, [1, 2, 3])    // [2, 3, 4]
strings: map(text, [1, 2, 3])   // ["1", "2", "3"]
