// Paper example 027: Selecting a value preserves its subtype

#noformat
#paper: 27
#mode: evaluation

-- paper.cue.txt --
min(A: number): func(x: A, y: A) -> A: {
    if x <= y {out: x}
    if x > y  {out: y}
}.out

m: min[int & >=10](12, 20)     // 12
-- in.cue --
@test(json, 12, at="m")

min(A: number): func(x: A, y: A) -> A: {
    if x <= y {out: x}
    if x > y  {out: y}
}.out

m: min[int & >=10](12, 20)     // 12
