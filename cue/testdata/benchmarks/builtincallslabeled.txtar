#inlinetest:exclude benchmark; outcomes covered by functions/builtins.txtar
# Benchmarks labeled calls to standard-library builtins: every call
# binds its arguments through the parameter names of the builtin's
# declared signature. The positional counterpart is
# builtincallspos.txtar; comparing the two isolates the cost of
# labeled-argument binding.
-- stats.txt --
Leaks:  0
Freed:  26003
Reused: 23993
Allocs: 2010
Retain: 0

Unifications: 26003
Conjuncts:    34004
Disjuncts:    0

NumCloseIDs: 8001

-- in.cue --
@experiment(functions,quantified=false)

import (
	"list"
	"strings"
)

r: list.Range(0, 2000, 1)
out: [for x in r {
	a: strings.Repeat("ab", count: 2)
	b: list.Drop(x: [1, 2, 3], n: 1)
	c: strings.SplitN("a,b,c", sep: ",", n: 2)
}]
