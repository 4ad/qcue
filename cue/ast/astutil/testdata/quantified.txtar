Quantified binder resolution, shadowing, and AST clone identity.

-- quantifier_scopes.cue --
@experiment(quantified)
let A = int
q: forall (A: A, B: A) {
    outer: A
    inner: exists A {a: A, b: B}
}
outside: A

-- alias_open_scopes.cue --
@experiment(quantified)
let A = int
Box(A, B: A) = {a: A, b: B}
p: seal #Package with (A = A) {value: 1}
x: open p as (A, P) {a: A, p: P}
