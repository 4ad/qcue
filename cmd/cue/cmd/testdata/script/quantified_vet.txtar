# Function type conformance is part of ordinary concrete validation.
exec cue vet structural.cue
! stderr .
exec cue vet -c structural.cue
! stderr .

# An unresolved proof is incomplete, not successful typed validation.
! exec cue vet residual.cue
stderr 'some instances are incomplete'
! exec cue vet -c residual.cue
stderr 'positive: function conformance remains unproved'

# Explicitly allowing incomplete constraints permits continued refinement.
exec cue vet -c=false residual.cue
! stderr .
exec cue export residual.cue -e observation
stdout '^0$'

# The proof request is no longer an independent option.
! exec cue vet --verify-functions structural.cue
stderr 'unknown flag: --verify-functions'

# A contradiction remains an error even in incomplete mode.
! exec cue vet invalid.cue
stderr 'function'
! exec cue vet -c=false invalid.cue
stderr 'function'

# All nested errors retain their paths, including later siblings.
! exec cue vet -c nested.cue
stderr 'box.f: function conformance remains unproved'
stderr 'box.g: function conformance remains unproved'
stderr 'items.0: function conformance remains unproved'

-- structural.cue --
package proof

identity(A): func(x: A) -> A: x
pair(A, B): func(x: A, y: B) -> [A, B]: [x, y]
map(A, B): func(g: func(A) -> B, xs: [...A]) -> [...B]: [
    for x in xs {g(x)}
]
useBoth: func(f: forall A func(A) -> A) -> [int, string]: [f(1), f("one")]

-- residual.cue --
package proof

// This true arithmetic fact is outside the structural proof fragment.
positive: func(x: int & >0) -> (int & >=0): x - 1
observation: positive(1)

-- invalid.cue --
f: func(int) -> string
f: func(x: int) -> int: x
-- nested.cue --
box: {
    f: func(x: int & >0) -> (int & >=0): x - 1
    g: func(y: int & >0) -> (int & >=0): y - 1
}
items: [func(x: int & >0) -> (int & >=0): x - 1]
