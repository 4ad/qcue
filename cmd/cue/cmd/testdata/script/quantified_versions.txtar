# Defaults follow the module's language version. Upgrading activates
# quantifiers without modifying the program or adding an attribute.
! exec cue export main.cue -e out
stderr 'requires @experiment\(quantified\)'

exec cue mod edit --language-version v0.18.0
exec cue export main.cue -e out
stdout '^3$'

-- cue.mod/module.cue --
module: "test.example/quantified"
language: version: "v0.17.0"
-- main.cue --
id: forall A func(x: A) -> A: x
out: id(3)
