# Quantifiers remain enabled when changing the module's language version,
# without modifying the program or adding an attribute.
exec cue export main.cue -e out
stdout '^3$'

exec cue mod edit --language-version v0.16.0
exec cue export main.cue -e out
stdout '^3$'

exec cue mod edit --language-version v0.18.0
exec cue export main.cue -e out
stdout '^3$'

-- cue.mod/module.cue --
module: "test.example/quantified"
language: version: "v0.17.0"
-- main.cue --
id: forall A func(x: A) -> A: x
out: id(3)
