exec cue version
stdout '^cue version '
stdout '^CUE language version v0.18.0$'
stdout 'S_H \(higher-rank quantifiers\), A \(opaque packages\)'
stdout '^quantified: enabled by default for all CUE language versions$'

exec cue help experiments
stdout 'functions \(preview: v0.0.0, default: v0.0.0\)'
stdout 'quantified \(preview: v0.0.0, default: v0.0.0\)'
exec cue completion bash
stdout '__start_cue'
! stdout '__start_qcue'
exec cue help completion
stdout 'bash_completion.d/cue'
stdout '/_cue'
stdout '/cue.fish'

exec cue export main.cue -e 'out[0]'
stdout '^3$'
exec cue export main.cue -e 'out[1]'
stdout '^"hello"$'

! exec cue eval invalid.cue
stderr 'quantifier syntax requires @experiment\(quantified\)'

exec cue export legacy.cue -e out
stdout '^3$'
exec cue def legacy.cue
stdout '@experiment\(functions,quantified=false\)'

exec cue export explicit.cue -e out
stdout '^3$'

cp unknown.cue.txt unknown.cue
! exec cue eval unknown.cue
stderr 'unknown experiment "quantified=invalid"'

-- cue.mod/module.cue --
module: "test.example/quantified"
language: version: "v0.18.0"
-- main.cue --
id(A): func(x: A) -> A: x
out: [id(3), id[string]("hello")]
-- invalid.cue --
@experiment(quantified=false)
x: forall A A
-- legacy.cue --
@experiment(functions,quantified=false)
f: func(x: int) -> int: x
out: f(3)
-- explicit.cue --
@experiment(quantified=true)
id(A): func(x: A) -> A: x
out: id(3)
-- unknown.cue.txt --
@experiment(quantified=invalid)
x: 1
