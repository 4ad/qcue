exec qcue version
stdout '^qcue version '
stdout '^CUE language version v0.18.0$'
stdout 'S_H \(higher-rank quantifiers\), A \(opaque packages\)'
stdout '^quantified: enabled by default'

exec qcue help experiments
stdout 'quantified \(preview: v0.18.0, default: v0.18.0\)'
exec qcue completion bash
stdout '__start_qcue'
! stdout '__start_cue'
exec qcue help completion
stdout 'bash_completion.d/qcue'
stdout '/_qcue'
stdout '/qcue.fish'

exec qcue export main.cue -e 'out[0]'
stdout '^3$'
exec qcue export main.cue -e 'out[1]'
stdout '^"hello"$'

! exec qcue eval invalid.cue
stderr 'quantifier syntax requires @experiment\(quantified\)'

exec qcue export legacy.cue -e out
stdout '^3$'
exec qcue def legacy.cue
stdout '@experiment\(functions,quantified=false\)'

exec qcue export explicit.cue -e out
stdout '^3$'

cp unknown.cue.txt unknown.cue
! exec qcue eval unknown.cue
stderr 'unknown experiment "quantified=invalid"'

-- cue.mod/module.cue --
module: "test.example/quantified"
language: version: "v0.18.0"
-- main.cue --
id(A): func(x: A) -> A: x
out: [id(3), id[string]("hello")]
-- invalid.cue --
@experiment(quantified=false)
x: forall A A
-- legacy.cue --
@experiment(functions,quantified=false)
f: func(x: int) -> int: x
out: f(3)
-- explicit.cue --
@experiment(quantified=true)
id(A): func(x: A) -> A: x
out: id(3)
-- unknown.cue.txt --
@experiment(quantified=invalid)
x: 1
