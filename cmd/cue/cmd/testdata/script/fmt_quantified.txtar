# Both formatters accept the quantified syntax at the module's language
# version, preserve comments, and leave the program's result unchanged.
exec cue export input.cue -e out --out json
cmp stdout result.json

env CUE_EXPERIMENT=formatv2=1
cp input.cue v2.cue
! exec cue fmt --check v2.cue
exec cue fmt v2.cue
exec cue fmt --check v2.cue
grep '// erased type' v2.cue
grep '^id\(' v2.cue
grep '// live description' v2.cue
exec cue export v2.cue -e out --out json
cmp stdout result.json

env CUE_EXPERIMENT=formatv2=0
cp input.cue v1.cue
! exec cue fmt --check v1.cue
exec cue fmt v1.cue
exec cue fmt --check v1.cue
grep '// erased type' v1.cue
grep '^id\(' v1.cue
grep '// live description' v1.cue
exec cue export v1.cue -e out --out json
cmp stdout result.json

-- cue.mod/module.cue --
module: "example.com/quantified"
language: version: "v0.18.0"
-- input.cue --
package test

Box(A)={value:A}
id(
    A, // erased type
):func(x:A)->A:x
local:func<A>(x:A)->A:x
State:int // live description
counter:{zero:0,read:func(x:State)->int:x}
opened:{value:counter.read(counter.zero)}
bridge:extern func(bytes)->int !decode
item:Box(string)&{value:"ok"}
out:[id[int](3),opened.value,local[string](item.value)]
-- result.json --
[
    3,
    0,
    "ok"
]
